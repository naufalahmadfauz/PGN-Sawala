# Use the international number without + or spaces when possible. If both are
# set, the phone number takes precedence over the chat name.
PGN_WHATSAPP_PHONE=
PGN_WHATSAPP_CHAT=

WHATSAPP_LOGIN_TIMEOUT_MS=900000
WHATSAPP_AUTH_TIMEOUT_MS=90000
WHATSAPP_RESPONSE_TIMEOUT_MS=60000
WHATSAPP_RESPONSE_IDLE_MS=10000
WHATSAPP_BETWEEN_TESTS_MS=3000

PGN_RESET_COMMAND=reset
PGN_RESET_CONFIRMATION=Session deleted
PGN_RESET_TIMEOUT_MS=30000
POST_RESET_QUIET_MS=10000

GOOGLE_DRIVE_EVIDENCE_ENABLED=false
GOOGLE_DRIVE_EVIDENCE_PARENT_FOLDER=
GOOGLE_DRIVE_EVIDENCE_FOLDER_PREFIX=PGN-WhatsApp-Evidence
GOOGLE_SERVICE_ACCOUNT_JSON=
# Optional override. Auto-detection currently resolves the legacy viewport to 497.
LEGACY_EVIDENCE_CROP_LEFT=

PGN_TEST_DATA_FILE=data/PGN_Test_Cases.xlsx
PGN_TEST_REPORT_FILE=reports/PGN_Test_Results.xlsx
PGN_SOURCE_WORKBOOK=data/PGN AI Assistant - Knowledge Base Testing Report - User Inputs.xlsx
PGN_EXECUTED_WORKBOOK=reports/PGN AI Assistant - Knowledge Base Testing Report - Executed.xlsx
